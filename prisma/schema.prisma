// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserType {
  PLATFORM_SUPER_ADMIN
  USER
}

enum TenantRole {
  OWNER
  MANAGER
  INVENTORY_STAFF
  CUSTOMER_SERVICE
  CUSTOM
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Permission {
  // Store / Tenant Permissions
  MANAGE_TENANT_SETTINGS
  VIEW_ANALYTICS

  // Products & Inventory Permissions
  CREATE_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  VIEW_PRODUCTS

  // Orders Permissions
  MANAGE_ORDERS
  VIEW_ORDERS

  // Users
  INVITE_USER
  DELETE_USER
}

enum StockMovementReason {
  PURCHASE_RESTOCK
  ORDER_RESERVATION
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
  RETURN_REFUND
}

enum PaymentGateway {
  STRIPE
  PAYMOB
  COD
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String            @map("password_hash")
  fullName          String            @map("full_name")
  phoneNumber       String?           @map("phone_number")
  birthDate         DateTime?         @map("birth_date")
  gender            Gender?
  userType          UserType          @default(USER) @map("user_type")
  isActive          Boolean           @default(true) @map("is_active")
  passwordChangedAt DateTime?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  ownedTenants      Tenant[]
  tenantRoles       TenantUserRole[]
  masterOrders      MasterOrder[]
  carts             Cart[]
  refreshTokens RefreshToken[]

  @@map("users")
}
model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @map("token_hash") 
  userId     String   @map("user_id")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true) @map("is_active")
  //Gateway preference
  preferredGateway        PaymentGateway @default(STRIPE) @map("preferred_gateway")
  // Stripe Data
  stripeAccountId          String?  @unique @map("stripe_account_id")
  stripeOnboardingComplete Boolean  @default(false) @map("stripe_onboarding_complete")
  stripeChargesEnabled     Boolean  @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled     Boolean  @default(false) @map("stripe_payouts_enabled")
  // Paymob Data
  paymobSubMerchantId     String?        @unique @map("paymob_sub_merchant_id")
  paymobOnboardingComplete Boolean       @default(false) @map("paymob_onboarding_complete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products            Product[]
  categories          Category[]
  tenantRoles         TenantUserRole[]
  customRoles         CustomRole[]
  tenantOrders        TenantOrder[]
  stockMovements      StockMovement[]
  carts               Cart[]
  image               TenantImage?
  paymentTransactions PaymentTransaction[]

  @@map("tenants")
}
model TenantImage {
  id        String   @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String 
  publicId  String   @map("public_id") 
  altText   String?  @map("alt_text")
  position  Int      @default(0) 
  createdAt DateTime @default(now()) @map("created_at")
  @@map("tenant_images")
}
model TenantUserRole {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId     String      @map("tenant_id")
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  role         TenantRole  @default(INVENTORY_STAFF)

  customRoleId String?     @map("custom_role_id")
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_user_roles")
}

model CustomRole {
  id              String           @id @default(uuid())
  name            String
  description     String?
  tenantId        String           @map("tenant_id")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  permissions     String[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenantUserRoles TenantUserRole[]

  @@unique([name, tenantId])
  @@map("custom_roles")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String
  description String?
  isActive    Boolean    @default(true)

  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  
  products    Product[]
  children    Category[] @relation("CategoryToCategory")

  @@map("categories")
  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
}

model Product {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId     String           @map("category_id")
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title          String
  slug           String
  description    String?
  price          Decimal          @db.Decimal(10, 2)
  compareAtPrice Decimal?         @db.Decimal(10, 2) @map("compare_at_price")
  sku            String?
  status         ProductStatus    @default(DRAFT)
  isFeatured     Boolean          @default(false) @map("is_featured")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String 
  publicId  String   @map("public_id") 
  altText   String?  @map("alt_text")
  position  Int      @default(0) 
  createdAt DateTime @default(now()) @map("created_at")
  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  productId      String          @map("product_id")
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  sku            String
  price          Decimal?        @db.Decimal(10, 2)
  stockQuantity  Int             @default(0) @map("stock_quantity")
  attributes     Json            @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  cartItems      CartItem[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@map("product_variants")
}

// ==================== CART MODELS ====================
model Cart {
  id        String     @id @default(uuid())
  tenantId  String     @map("tenant_id")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?    @map("user_id") // Optional: NULL for Guest Users
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @map("session_id") // For guest cart identification (cookie/token)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  items     CartItem[]
  @@unique([tenantId, userId])
  @@unique([tenantId, sessionId])
  @@index([tenantId, userId])
  @@index([tenantId, sessionId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String         @map("cart_id")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ==================== ORDER MODELS ====================
model MasterOrder {
  id                    String        @id @default(uuid())
  userId                String?       @map("user_id")
  user                  User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  guestEmail            String?       @map("guest_email")
  guestName             String?       @map("guest_name")
  guestPhone            String?       @map("guest_phone")
  
  totalAmount           Decimal       @db.Decimal(10, 2) @map("total_amount")
  currency              String        @default("EGP")
  
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  paymentGateway        String?       @default("STRIPE") @map("payment_gateway")
  
  stripeCheckoutSessionId String?     @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?     @unique @map("stripe_payment_intent_id")
  
  shippingAddress       Json          @db.JsonB @map("shipping_address")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  tenantOrders TenantOrder[]
  transactions PaymentTransaction[]

  @@index([userId])
  @@index([stripePaymentIntentId])
  @@map("master_orders")
}

model TenantOrder {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  masterOrderId  String      @map("master_order_id")
  masterOrder    MasterOrder @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  
  subTotal       Decimal     @db.Decimal(10, 2) @map("sub_total")
  
  applicationFee Decimal?    @db.Decimal(10, 2) @map("application_fee")
  netAmount      Decimal?    @db.Decimal(10, 2) @map("net_amount")
  
  stripeTransferId String?   @unique @map("stripe_transfer_id")
  
  orderStatus    OrderStatus @default(PENDING) @map("order_status")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([masterOrderId])
  @@index([tenantId])
  @@map("tenant_orders")
}

model OrderItem {
  id            String         @id @default(uuid())
  tenantOrderId String         @map("tenant_order_id")
  tenantOrder   TenantOrder    @relation(fields: [tenantOrderId], references: [id], onDelete: Cascade)
  productId     String         @map("product_id")
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId     String         @map("variant_id") // Strictly required
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity      Int
  unitPrice     Decimal        @db.Decimal(10, 2) @map("unit_price")
  totalPrice    Decimal        @db.Decimal(10, 2) @map("total_price")
  createdAt     DateTime       @default(now()) @map("created_at")
  @@index([tenantOrderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model StockMovement {
  id          String              @id @default(uuid())
  tenantId    String              @map("tenant_id")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId   String              @map("variant_id")
  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int
  reason      StockMovementReason
  referenceId String?             @map("reference_id")
  note        String?
  createdById String?             @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([tenantId, variantId])
  @@map("stock_movements")
}

model PaymentTransaction {
  id              String       @id @default(uuid())
  masterOrderId   String?      @map("master_order_id")
  masterOrder     MasterOrder? @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  
  tenantId        String?      @map("tenant_id")
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  
  stripeAccountId String?      @map("stripe_account_id")
  
  eventId         String       @unique @map("event_id")
  eventType       String       @map("event_type")
  
  amount          Decimal?     @db.Decimal(10, 2)
  currency        String?      @default("EGP")
  status          String
  
  rawPayload      Json?        @map("raw_payload") @db.JsonB

  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([masterOrderId])
  @@index([tenantId])
  @@index([eventId])
  @@map("payment_transactions")
}